{
  "description": "My2Consents — respect release cache headers",
  "expression": "(http.host eq \"assets.l3ss.io\" and starts_with(http.request.uri.path, \"/my2consents/\"))",
  "action": "set_cache_settings",
  "action_parameters": {
    "cache": true,
    "browser_ttl": { "mode": "respect_origin" }
  },
  "enabled": true
}
