{
  "name": "my2consents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable multilingual first-party consent banner",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "build": "vite build",
    "check:size": "node scripts/check-bundle-size.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check:size"
  },
  "dependencies": {
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
